<Project>

  <!--
    Solution-wide build properties for Scrybe.
    Enforces the non-negotiable quality bar: nullable reference types,
    warnings treated as errors, and code-style rules enforced at build time
    (so the editorconfig "no var" / file-scoped namespace rules actually fail
    the build instead of being silently ignored).
  -->

  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>10.0</AnalysisLevel>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Julien Bombled</Authors>
    <Company>Julien Bombled</Company>
    <Product>Scrybe</Product>
    <Copyright>Copyright 2026 Julien Bombled</Copyright>
    <Version>1.0.0906.1</Version>
    <InformationalVersion>2026.090601</InformationalVersion>
    <BuildDate></BuildDate>
    <CommitHash></CommitHash>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="BuildDate" Value="$(BuildDate)" />
    <AssemblyMetadata Include="CommitHash" Value="$(CommitHash)" />
  </ItemGroup>

</Project>
