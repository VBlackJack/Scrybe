<UserControl x:Class="Scrybe.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Scrybe.App.Localization"
             xmlns:views="clr-namespace:Scrybe.App.Views"
             Background="{StaticResource BackgroundBrush}"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSubheading}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Width" Value="190" />
        </Style>
        <Style x:Key="SettingCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,6,0,6" />
        </Style>
        <Style x:Key="SettingComboStyle" TargetType="ComboBox" BasedOn="{StaticResource AppComboBoxStyle}">
            <Setter Property="Width" Value="240" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style x:Key="SettingTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Padding" Value="{StaticResource PaddingInput}" />
            <Setter Property="Width" Value="240" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="{StaticResource PaddingSectionCard}" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="ReadOnlyValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="{StaticResource SpacingLg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="1"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{loc:Translate Settings.UnsavedChanges}"
                               Foreground="{StaticResource WarningBrush}"
                               FontSize="{StaticResource FontSizeCaption}">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasPendingChanges}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <Button Command="{Binding SaveCommand}"
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Padding="{StaticResource PaddingButtonPrimary}"
                        Background="{StaticResource AccentBrush}"
                        Foreground="{StaticResource ActionOnBrightBrush}"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        AutomationProperties.Name="{loc:Translate Settings.Save}">
                    <StackPanel Style="{StaticResource AppIconTextContentStyle}">
                        <TextBlock Text="{StaticResource IconActionSave}" Style="{StaticResource AppIconGlyphStyle}" />
                        <TextBlock Text="{loc:Translate Settings.Save}" Style="{StaticResource AppIconTextStyle}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,0,72">

                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{loc:Translate Settings.General}" Style="{StaticResource SectionHeaderStyle}" />
                        <CheckBox Content="{loc:Translate Settings.EnableLogging}"
                                  IsChecked="{Binding EnableLogging}"
                                  Style="{StaticResource SettingCheckBoxStyle}"
                                  ToolTip="{loc:Translate ToolTip.Settings.EnableLogging}"
                                  AutomationProperties.Name="{loc:Translate Settings.EnableLogging}"
                                  AutomationProperties.HelpText="{loc:Translate ToolTip.Settings.EnableLogging}" />
                        <CheckBox Content="{loc:Translate Settings.PrewarmOnStartup}"
                                  IsChecked="{Binding PrewarmOnStartup}"
                                  Style="{StaticResource SettingCheckBoxStyle}"
                                  ToolTip="{loc:Translate ToolTip.Settings.PrewarmOnStartup}"
                                  AutomationProperties.Name="{loc:Translate Settings.PrewarmOnStartup}"
                                  AutomationProperties.HelpText="{loc:Translate ToolTip.Settings.PrewarmOnStartup}" />
                        <CheckBox Content="{loc:Translate Settings.StartWithWindows}"
                                  IsChecked="{Binding StartWithWindows}"
                                  Style="{StaticResource SettingCheckBoxStyle}"
                                  AutomationProperties.Name="{loc:Translate Settings.StartWithWindows}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{loc:Translate Settings.Locale}" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox ItemsSource="{Binding LocaleChoices}" SelectedValuePath="Value" SelectedValue="{Binding LocaleCode}" Style="{StaticResource SettingComboStyle}" AutomationProperties.Name="{loc:Translate Settings.Locale}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{loc:Translate Settings.Ocr}" Style="{StaticResource SectionHeaderStyle}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Translate Settings.CleanupMode}"
                                       Style="{StaticResource FieldLabelStyle}"
                                       ToolTip="{loc:Translate ToolTip.Settings.CleanupMode}" />
                            <ComboBox ItemsSource="{Binding CleanupModeChoices}"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding CleanupMode}"
                                      Style="{StaticResource SettingComboStyle}"
                                      ToolTip="{loc:Translate ToolTip.Settings.CleanupMode}"
                                      AutomationProperties.Name="{loc:Translate Settings.CleanupMode}"
                                      AutomationProperties.HelpText="{loc:Translate ToolTip.Settings.CleanupMode}" />
                        </StackPanel>
                        <CheckBox Content="{loc:Translate Settings.EnablePreprocessing}"
                                  IsChecked="{Binding EnablePreprocessing}"
                                  Style="{StaticResource SettingCheckBoxStyle}"
                                  ToolTip="{loc:Translate ToolTip.Settings.EnablePreprocessing}"
                                  AutomationProperties.Name="{loc:Translate Settings.EnablePreprocessing}"
                                  AutomationProperties.HelpText="{loc:Translate ToolTip.Settings.EnablePreprocessing}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{loc:Translate Settings.Injection}" Style="{StaticResource SectionHeaderStyle}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Translate Settings.InjectionMode}"
                                       Style="{StaticResource FieldLabelStyle}"
                                       ToolTip="{loc:Translate ToolTip.Settings.InjectionMode}" />
                            <ComboBox ItemsSource="{Binding InjectionModeChoices}"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding InjectionMode}"
                                      Style="{StaticResource SettingComboStyle}"
                                      ToolTip="{loc:Translate ToolTip.Settings.InjectionMode}"
                                      AutomationProperties.Name="{loc:Translate Settings.InjectionMode}"
                                      AutomationProperties.HelpText="{loc:Translate ToolTip.Settings.InjectionMode}" />
                        </StackPanel>
                        <CheckBox Content="{loc:Translate Settings.ClearClipboardAfterInjection}"
                                  IsChecked="{Binding ClearClipboardAfterInjection}"
                                  Style="{StaticResource SettingCheckBoxStyle}"
                                  ToolTip="{loc:Translate ToolTip.Settings.ClearClipboardAfterInjection}"
                                  AutomationProperties.Name="{loc:Translate Settings.ClearClipboardAfterInjection}"
                                  AutomationProperties.HelpText="{loc:Translate ToolTip.Settings.ClearClipboardAfterInjection}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="{loc:Translate Settings.Pacing}"
                                       Style="{StaticResource FieldLabelStyle}"
                                       ToolTip="{loc:Translate ToolTip.Settings.Pacing}" />
                            <StackPanel Orientation="Horizontal">
                                <Button Command="{Binding DecreaseInjectionKeyDelayCommand}"
                                        Content="-"
                                        Width="30"
                                        Padding="0"
                                        ToolTip="{loc:Translate Settings.DecreaseValue}"
                                        AutomationProperties.Name="{loc:Translate Settings.DecreaseValue}" />
                                <TextBox Text="{Binding InjectionKeyDelayMs, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SettingTextBoxStyle}"
                                         Width="70"
                                         Margin="6,0"
                                         InputScope="Number"
                                         ToolTip="{loc:Translate ToolTip.Settings.Pacing}"
                                         AutomationProperties.Name="{loc:Translate Settings.Pacing}"
                                         AutomationProperties.HelpText="{loc:Translate ToolTip.Settings.Pacing}" />
                                <Button Command="{Binding IncreaseInjectionKeyDelayCommand}"
                                        Content="+"
                                        Width="30"
                                        Padding="0"
                                        ToolTip="{loc:Translate Settings.IncreaseValue}"
                                        AutomationProperties.Name="{loc:Translate Settings.IncreaseValue}" />
                                <TextBlock Text="{Binding InjectionKeyDelayRangeText}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{loc:Translate Settings.InjectionReferenceLength}"
                                       Style="{StaticResource FieldLabelStyle}"
                                       ToolTip="{loc:Translate ToolTip.Settings.InjectionIntegrity}" />
                            <WrapPanel Grid.Column="1">
                                <ComboBox ItemsSource="{Binding InjectionReferenceLengthChoices}"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding SelectedInjectionReferenceLength}"
                                          Style="{StaticResource SettingComboStyle}"
                                          Width="160"
                                          Margin="0,0,8,8"
                                          ToolTip="{loc:Translate ToolTip.Settings.InjectionIntegrity}"
                                          AutomationProperties.Name="{loc:Translate Settings.InjectionReferenceLength}"
                                          AutomationProperties.HelpText="{loc:Translate ToolTip.Settings.InjectionIntegrity}" />
                                <Button Command="{Binding CopyInjectionReferenceCommand}"
                                        Margin="0,0,8,8"
                                        AutomationProperties.Name="{loc:Translate Settings.CopyInjectionReference}">
                                    <StackPanel Style="{StaticResource AppIconTextContentStyle}">
                                        <TextBlock Text="{StaticResource IconActionCopy}" Style="{StaticResource AppIconGlyphStyle}" />
                                        <TextBlock Text="{loc:Translate Settings.CopyInjectionReference}" Style="{StaticResource AppIconTextStyle}" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding InjectReferenceCommand}"
                                        Margin="0,0,0,8"
                                        Background="{StaticResource AccentBrush}"
                                        Foreground="{StaticResource ActionOnBrightBrush}"
                                        BorderThickness="0"
                                        FontWeight="SemiBold"
                                        AutomationProperties.Name="{loc:Translate Settings.InjectReference}">
                                    <StackPanel Style="{StaticResource AppIconTextContentStyle}">
                                        <TextBlock Text="{StaticResource IconActionPlay}" Style="{StaticResource AppIconGlyphStyle}" />
                                        <TextBlock Text="{loc:Translate Settings.InjectReference}" Style="{StaticResource AppIconTextStyle}" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </Grid>
                        <TextBlock Text="{Binding InjectionIntegrityStatusMessage}"
                                   Margin="190,8,0,0"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInjectionIntegrityStatusError}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{loc:Translate Settings.Captures}" Style="{StaticResource SectionHeaderStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{loc:Translate Settings.CapturesDirectory}"
                                       Style="{StaticResource FieldLabelStyle}"
                                       ToolTip="{loc:Translate ToolTip.Settings.CapturesDirectory}" />
                            <WrapPanel Grid.Column="1">
                                <TextBox Text="{Binding CapturesDirectory, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SettingTextBoxStyle}"
                                         Margin="0,0,8,8"
                                         ToolTip="{loc:Translate ToolTip.Settings.CapturesDirectory}"
                                         AutomationProperties.Name="{loc:Translate Settings.CapturesDirectory}"
                                         AutomationProperties.HelpText="{loc:Translate ToolTip.Settings.CapturesDirectory}" />
                                <Button Command="{Binding BrowseCapturesDirectoryCommand}"
                                        Margin="0,0,8,8"
                                        AutomationProperties.Name="{loc:Translate Settings.BrowseCapturesDirectory}">
                                    <TextBlock Text="{loc:Translate Settings.BrowseCapturesDirectory}" />
                                </Button>
                                <Button Command="{Binding OpenCapturesDirectoryCommand}"
                                        Margin="0,0,8,8"
                                        AutomationProperties.Name="{loc:Translate Settings.OpenCapturesDirectory}">
                                    <StackPanel Style="{StaticResource AppIconTextContentStyle}">
                                        <TextBlock Text="{StaticResource IconActionOpenFolder}" Style="{StaticResource AppIconGlyphStyle}" />
                                        <TextBlock Text="{loc:Translate Settings.OpenCapturesDirectory}" Style="{StaticResource AppIconTextStyle}" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ResetCapturesDirectoryCommand}"
                                        Margin="0,0,0,8"
                                        AutomationProperties.Name="{loc:Translate Settings.ResetCapturesDirectory}">
                                    <TextBlock Text="{loc:Translate Settings.ResetCapturesDirectory}" />
                                </Button>
                            </WrapPanel>
                        </Grid>
                        <CheckBox Content="{loc:Translate Settings.SaveCaptureCrop}"
                                  IsChecked="{Binding SaveCaptureCrop}"
                                  Style="{StaticResource SettingCheckBoxStyle}"
                                  Margin="0,10,0,0"
                                  ToolTip="{loc:Translate ToolTip.Settings.SaveCaptureCrop}"
                                  AutomationProperties.Name="{loc:Translate Settings.SaveCaptureCrop}"
                                  AutomationProperties.HelpText="{loc:Translate ToolTip.Settings.SaveCaptureCrop}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{loc:Translate Settings.History}" Style="{StaticResource SectionHeaderStyle}" />
                        <CheckBox Content="{loc:Translate Settings.EnableCaptureHistory}"
                                  IsChecked="{Binding EnableCaptureHistory}"
                                  Style="{StaticResource SettingCheckBoxStyle}"
                                  ToolTip="{loc:Translate ToolTip.Settings.EnableCaptureHistory}"
                                  AutomationProperties.Name="{loc:Translate Settings.EnableCaptureHistory}"
                                  AutomationProperties.HelpText="{loc:Translate ToolTip.Settings.EnableCaptureHistory}" />
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,8,0,0"
                                    ToolTip="{loc:Translate ToolTip.Settings.HistoryMaxEntries}">
                            <TextBlock Text="{loc:Translate Settings.HistoryMaxEntries}"
                                       Style="{StaticResource FieldLabelStyle}" />
                            <StackPanel Orientation="Horizontal">
                                <Button Command="{Binding DecreaseCaptureHistoryMaxEntriesCommand}"
                                        Content="-"
                                        Width="30"
                                        Padding="0"
                                        ToolTip="{loc:Translate Settings.DecreaseValue}"
                                        AutomationProperties.Name="{loc:Translate Settings.DecreaseValue}" />
                                <TextBox Text="{Binding CaptureHistoryMaxEntries, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SettingTextBoxStyle}"
                                         Width="70"
                                         Margin="6,0"
                                         InputScope="Number"
                                         AutomationProperties.Name="{loc:Translate Settings.HistoryMaxEntries}"
                                         AutomationProperties.HelpText="{loc:Translate ToolTip.Settings.HistoryMaxEntries}" />
                                <Button Command="{Binding IncreaseCaptureHistoryMaxEntriesCommand}"
                                        Content="+"
                                        Width="30"
                                        Padding="0"
                                        ToolTip="{loc:Translate Settings.IncreaseValue}"
                                        AutomationProperties.Name="{loc:Translate Settings.IncreaseValue}" />
                                <TextBlock Text="{Binding CaptureHistoryMaxEntriesRangeText}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{loc:Translate Settings.Hotkeys}" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock Text="{loc:Translate Settings.HotkeysNote}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <views:HotkeyRecorder DataContext="{Binding CaptureRecorder}" />
                        <views:HotkeyRecorder DataContext="{Binding InjectRecorder}" />
                        <views:HotkeyRecorder DataContext="{Binding ClipboardInjectRecorder}" />
                        <views:HotkeyRecorder DataContext="{Binding AbortRecorder}" />
                        <views:HotkeyRecorder DataContext="{Binding PaletteRecorder}" />
                        <views:HotkeyRecorder DataContext="{Binding SecretPaletteRecorder}" />
                        <views:HotkeyRecorder DataContext="{Binding HistoryPaletteRecorder}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
