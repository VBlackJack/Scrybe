<Window x:Class="Scrybe.App.Views.SecretPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Scrybe.App.Localization"
        Title="{loc:Translate Secrets.PaletteTitle}"
        Height="380"
        Width="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        ShowInTaskbar="False"
        UseLayoutRounding="True">

    <DockPanel Margin="{StaticResource SpacingLg}">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{loc:Translate Secrets.Inject}"
                    Command="{Binding InjectCommand}"
                    IsEnabled="{Binding CanInject}"
                    IsDefault="True"
                    Padding="{StaticResource PaddingButtonPrimary}"
                    Background="{StaticResource AccentBrush}"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                    AutomationProperties.Name="{loc:Translate Secrets.Inject}" />
        </StackPanel>

        <ListBox ItemsSource="{Binding Secrets}"
                 SelectedItem="{Binding SelectedSecret}"
                 Background="{StaticResource SurfaceBrush}"
                 Foreground="{StaticResource TextPrimaryBrush}"
                 BorderBrush="{StaticResource BorderBrush}"
                 BorderThickness="1"
                 FontSize="{StaticResource FontSizeBody}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,4">
                        <TextBlock Text="{Binding Name}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="{StaticResource FontSizeBodyLarge}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding UserName}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="{StaticResource FontSizeCaption}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
