<Window x:Class="Scrybe.App.Views.OcrReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Scrybe.App.Localization"
        Title="{loc:Translate Review.Title}" Width="{StaticResource ReviewWindowWidth}"
        Height="{StaticResource ReviewWindowHeight}" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="{StaticResource SpacingLg}" Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="{loc:Translate Review.Hint}" TextWrapping="Wrap" Margin="{StaticResource MarginStackItem}"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Image x:Name="Crop" Stretch="None" AutomationProperties.Name="{loc:Translate Review.Image}"/>
            </ScrollViewer>
            <TextBox x:Name="Editor" Grid.Column="1" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="{StaticResource CodeFontFamily}"
                     AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                     Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                     CaretBrush="{DynamicResource TextPrimaryBrush}" Padding="{StaticResource PaddingInput}"
                     AutomationProperties.Name="{loc:Translate Review.Text}"/>
        </Grid>
        <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="{StaticResource MarginSectionTop}">
            <Button Command="{Binding CancelCommand}" IsCancel="True" Content="{loc:Translate Review.Cancel}"
                    Style="{StaticResource FeatureButtonStyle}" AutomationProperties.Name="{loc:Translate Review.Cancel}"/>
            <Button Command="{Binding AcceptCommand}" Content="{loc:Translate Review.Accept}"
                    Style="{StaticResource FeatureButtonStyle}" AutomationProperties.Name="{loc:Translate Review.Accept}"/>
        </WrapPanel>
    </Grid>
</Window>
