<UserControl x:Class="Scrybe.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Scrybe.App.Localization"
             Background="{StaticResource BackgroundBrush}"
             TextOptions.TextFormattingMode="Ideal"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <Style x:Key="AboutCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="{StaticResource PaddingSectionCard}" />
        </Style>
        <Style x:Key="AboutLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="AboutValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="AboutSectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeLarge}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="AboutStatusBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasStatus}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                    <Setter Property="Background" Value="{StaticResource ErrorBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="{StaticResource SpacingLg}"
              MaxWidth="620"
              HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="0,10,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Image Source="/Assets/Scrybe.ico"
                       Width="48"
                       Height="48"
                       VerticalAlignment="Center"
                       AutomationProperties.Name="{Binding AppName}" />

                <StackPanel Grid.Column="1"
                            Margin="14,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding AppName}"
                               Style="{StaticResource AppTitleTextStyle}"
                               HorizontalAlignment="Left"
                               Margin="0,0,0,4"
                               AutomationProperties.Name="{Binding AppName}" />
                    <TextBlock Text="{Binding Tagline}"
                               Style="{StaticResource AppTaglineTextStyle}"
                               HorizontalAlignment="Left"
                               TextAlignment="Left"
                               Margin="0"
                               MaxWidth="520"
                               AutomationProperties.Name="{Binding Tagline}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Style="{StaticResource AboutCardStyle}">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="118" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding Label}"
                                           Style="{StaticResource AboutLabelStyle}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Value}"
                                           Style="{StaticResource AboutValueStyle}"
                                           Margin="16,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Grid Grid.Row="2"
                  Margin="0,20,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding DiagnosticsTitle}"
                           Style="{StaticResource AboutSectionHeaderStyle}"
                           VerticalAlignment="Center"
                           AutomationProperties.Name="{Binding DiagnosticsTitle}" />

                <WrapPanel Grid.Column="1"
                           HorizontalAlignment="Right">
                    <Button Command="{Binding CopyDiagnosticReportCommand}"
                            Margin="0,0,8,0"
                            AutomationProperties.Name="{loc:Translate Diagnostics.CopyReport}">
                        <StackPanel Style="{StaticResource AppIconTextContentStyle}">
                            <TextBlock Text="{StaticResource IconActionCopy}" Style="{StaticResource AppIconGlyphStyle}" />
                            <TextBlock Text="{loc:Translate Diagnostics.CopyReport}" Style="{StaticResource AppIconTextStyle}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenLogsDirectoryCommand}"
                            Margin="0,0,8,0"
                            AutomationProperties.Name="{loc:Translate Diagnostics.OpenLogs}">
                        <StackPanel Style="{StaticResource AppIconTextContentStyle}">
                            <TextBlock Text="{StaticResource IconActionOpenFolder}" Style="{StaticResource AppIconGlyphStyle}" />
                            <TextBlock Text="{loc:Translate Diagnostics.OpenLogs}" Style="{StaticResource AppIconTextStyle}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenAppDataDirectoryCommand}"
                            AutomationProperties.Name="{loc:Translate Diagnostics.OpenAppData}">
                        <StackPanel Style="{StaticResource AppIconTextContentStyle}">
                            <TextBlock Text="{StaticResource IconActionOpenFolder}" Style="{StaticResource AppIconGlyphStyle}" />
                            <TextBlock Text="{loc:Translate Diagnostics.OpenAppData}" Style="{StaticResource AppIconTextStyle}" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Grid>

            <Border Grid.Row="3"
                    Style="{StaticResource AboutCardStyle}">
                <ItemsControl ItemsSource="{Binding DiagnosticRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="124" />
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding Label}"
                                           Style="{StaticResource AboutLabelStyle}" />
                                <Border Grid.Column="1"
                                        Style="{StaticResource AboutStatusBadgeStyle}">
                                    <TextBlock Text="{Binding Status}"
                                               FontSize="{StaticResource FontSizeCaption}"
                                               FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource ActionOnBrightBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Value}"
                                           ToolTip="{Binding Value}"
                                           FontFamily="Consolas"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           Margin="12,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource AboutValueStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Grid.Column="3"
                                        Command="{Binding DataContext.CopyDiagnosticValueCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding Value}"
                                        Padding="8,4"
                                        Margin="8,0,0,0"
                                        ToolTip="{loc:Translate Diagnostics.CopyValue}"
                                        AutomationProperties.Name="{loc:Translate Diagnostics.CopyValue}">
                                    <TextBlock Text="{StaticResource IconActionCopy}"
                                               Style="{StaticResource AppIconGlyphStyle}"
                                               Margin="0" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <TextBlock Grid.Row="4"
                       Text="{Binding StatusMessage}"
                       Margin="0,10,0,0"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </ScrollViewer>
</UserControl>
