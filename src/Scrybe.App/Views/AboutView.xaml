<UserControl x:Class="Scrybe.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}"
             TextOptions.TextFormattingMode="Ideal"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <Style x:Key="AboutCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="{StaticResource PaddingSectionCard}" />
        </Style>
        <Style x:Key="AboutLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="AboutValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="{StaticResource SpacingLg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        HorizontalAlignment="Center"
                        Margin="0,4,0,20">
                <Image Source="/Assets/Scrybe.ico"
                       Width="48"
                       Height="48"
                       Margin="0,0,0,8"
                       AutomationProperties.Name="{Binding AppName}" />
                <TextBlock Text="{Binding AppName}"
                           Style="{StaticResource AppTitleTextStyle}"
                           AutomationProperties.Name="{Binding AppName}" />
                <TextBlock Text="{Binding Tagline}"
                           Style="{StaticResource AppTaglineTextStyle}"
                           MaxWidth="360"
                           AutomationProperties.Name="{Binding Tagline}" />
                <TextBlock Text="{Binding Version}"
                           Style="{StaticResource AppVersionTextStyle}" />
            </StackPanel>

            <Border Grid.Row="1"
                    Style="{StaticResource AboutCardStyle}">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="128" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding Label}"
                                           Style="{StaticResource AboutLabelStyle}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Value}"
                                           Style="{StaticResource AboutValueStyle}"
                                           Margin="16,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
