<Window x:Class="Scrybe.App.Views.HistoryPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Scrybe.App.Localization"
        Title="{loc:Translate History.PaletteTitle}"
        Height="460"
        Width="620"
        MinHeight="380"
        MinWidth="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        ShowInTaskbar="False"
        UseLayoutRounding="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <DockPanel Margin="{StaticResource SpacingLg}">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{loc:Translate History.Delete}"
                    Command="{Binding DeleteCommand}"
                    IsEnabled="{Binding CanCopy}"
                    Padding="{StaticResource PaddingButtonPrimary}"
                    Background="{StaticResource CardBrush}"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Margin="0,0,8,0"
                    AutomationProperties.Name="{loc:Translate History.Delete}" />
            <Button Content="{loc:Translate History.ClearAll}"
                    Command="{Binding ClearAllCommand}"
                    IsEnabled="{Binding HasEntries}"
                    Padding="{StaticResource PaddingButtonPrimary}"
                    Background="{StaticResource CardBrush}"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Margin="0,0,8,0"
                    AutomationProperties.Name="{loc:Translate History.ClearAll}" />
            <Button Content="{loc:Translate History.Copy}"
                    Command="{Binding CopyCommand}"
                    IsEnabled="{Binding CanCopy}"
                    IsDefault="True"
                    Padding="{StaticResource PaddingButtonPrimary}"
                    Background="{StaticResource AccentBrush}"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                    AutomationProperties.Name="{loc:Translate History.Copy}" />
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <ListBox ItemsSource="{Binding Entries}"
                         SelectedItem="{Binding SelectedEntry}"
                         Background="{StaticResource SurfaceBrush}"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         BorderBrush="{StaticResource BorderBrush}"
                         BorderThickness="1"
                         FontSize="{StaticResource FontSizeBody}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Text="{Binding Preview}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="{StaticResource FontSizeBodyLarge}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Row="0"
                                           Grid.Column="1"
                                           Text="{Binding CharCount}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           Margin="16,0,0,0" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           Grid.ColumnSpan="2"
                                           Text="{Binding Timestamp}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="{StaticResource FontSizeCaption}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="{loc:Translate History.Empty}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="{StaticResource FontSizeBody}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center" />
            </Grid>

            <TextBox Grid.Row="2"
                     Text="{Binding SelectedPreview}"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Height="80"
                     Background="{StaticResource SurfaceBrush}"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     CaretBrush="{StaticResource TextPrimaryBrush}"
                     BorderBrush="{StaticResource BorderBrush}"
                     Padding="{StaticResource PaddingInput}"
                     AutomationProperties.Name="{loc:Translate History.Preview}" />
        </Grid>
    </DockPanel>
</Window>
