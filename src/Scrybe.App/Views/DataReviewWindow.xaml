<Window x:Class="Scrybe.App.Views.DataReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Scrybe.App.Localization"
        Title="{Binding Title}" Width="{StaticResource ReviewWindowWidth}" Height="{StaticResource ReviewWindowHeight}"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="{StaticResource SpacingLg}" Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="{StaticResource MarginStackItem}"/>
        <ListBox Grid.Row="1" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}" DisplayMemberPath="Label"
                 AutomationProperties.Name="{loc:Translate DataReview.Entries}" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"/>
        <ComboBox Grid.Row="2" ItemsSource="{Binding Policies}" SelectedItem="{Binding SelectedPolicy}"
                  IsEnabled="{Binding HasPolicies}" Style="{StaticResource AppComboBoxStyle}" AutomationProperties.Name="{loc:Translate Exchange.Policy}">
            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <TextBox Grid.Row="3" Text="{Binding SelectedDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap"
                 FontFamily="{StaticResource CodeFontFamily}"
                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                 Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                 AutomationProperties.Name="{loc:Translate Review.Text}"/>
        <WrapPanel Grid.Row="4" HorizontalAlignment="Right">
            <Button Command="{Binding CancelCommand}" IsCancel="True" Content="{loc:Translate Review.Cancel}"
                    Style="{StaticResource FeatureButtonStyle}" AutomationProperties.Name="{loc:Translate Review.Cancel}"/>
            <Button Command="{Binding AcceptCommand}" Content="{loc:Translate DataReview.Continue}"
                    Style="{StaticResource FeatureButtonStyle}" AutomationProperties.Name="{loc:Translate DataReview.Continue}"/>
        </WrapPanel>
    </Grid>
</Window>
