<Window x:Class="Scrybe.App.Views.SnippetPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Scrybe.App.Localization"
        Title="{loc:Translate Palette.Title}"
        Height="500"
        Width="800"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        ShowInTaskbar="False"
        UseLayoutRounding="True">

    <Grid Margin="{StaticResource SpacingLg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ListBox x:Name="SnippetList"
                 Grid.Column="0"
                 ItemsSource="{Binding Snippets}"
                 SelectedItem="{Binding SelectedSnippet}"
                 DisplayMemberPath="Name"
                 Background="{StaticResource SurfaceBrush}"
                 Foreground="{StaticResource TextPrimaryBrush}"
                 BorderBrush="{StaticResource BorderBrush}"
                 BorderThickness="1"
                 FontSize="{StaticResource FontSizeBody}"
                 Margin="0,0,16,0" />

        <DockPanel Grid.Column="1">

            <TextBlock DockPanel.Dock="Top"
                       Text="{loc:Translate Palette.Parameters}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="{StaticResource FontSizeCaption}"
                       Margin="{StaticResource MarginLabelBottom}" />

            <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Fields}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="{StaticResource MarginStackItem}">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="{Binding Label}"
                                       Width="130"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="{StaticResource FontSizeBody}" />
                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{StaticResource SurfaceBrush}"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     CaretBrush="{StaticResource TextPrimaryBrush}"
                                     BorderBrush="{StaticResource BorderBrush}"
                                     Padding="{StaticResource PaddingInput}" />
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="{loc:Translate Palette.Inject}"
                        Command="{Binding InjectCommand}"
                        IsEnabled="{Binding CanInject}"
                        IsDefault="True"
                        Padding="{StaticResource PaddingButtonPrimary}"
                        Background="{StaticResource AccentBrush}"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        AutomationProperties.Name="{loc:Translate Palette.Inject}" />
            </StackPanel>

            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Margin="0,16,0,0"
                    Padding="{StaticResource PaddingSectionCard}">
                <TextBox Text="{Binding Preview, Mode=OneWay}"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Background="Transparent"
                         Foreground="{StaticResource SuccessBrush}"
                         BorderThickness="0"
                         FontFamily="Consolas"
                         FontSize="{StaticResource FontSizeBody}" />
            </Border>
        </DockPanel>
    </Grid>
</Window>
