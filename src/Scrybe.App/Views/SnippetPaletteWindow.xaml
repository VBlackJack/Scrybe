<Window x:Class="Scrybe.App.Views.SnippetPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Scrybe.App.Localization"
        Title="{loc:Translate Palette.Title}"
        Height="520"
        Width="820"
        MinHeight="420"
        MinWidth="640"
        WindowStartupLocation="Manual"
        Background="{StaticResource BackgroundBrush}"
        ShowInTaskbar="False"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="PaletteEmptyTextStyle" TargetType="TextBlock" BasedOn="{StaticResource ManagerEmptyStateTextStyle}">
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </Window.Resources>

    <Grid Margin="{StaticResource SpacingLg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="0,0,16,0">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBox x:Name="SearchBox"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Background="{StaticResource SurfaceBrush}"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         CaretBrush="{StaticResource TextPrimaryBrush}"
                         BorderBrush="{StaticResource BorderBrush}"
                         Padding="{StaticResource PaddingInput}"
                         AutomationProperties.Name="{loc:Translate Palette.Search}" />
                <TextBlock Text="{loc:Translate Palette.SearchPlaceholder}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <Grid>
                <ListBox x:Name="SnippetList"
                         ItemsSource="{Binding Snippets}"
                         SelectedItem="{Binding SelectedSnippet}"
                         DisplayMemberPath="Name"
                         Background="{StaticResource SurfaceBrush}"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         BorderBrush="{StaticResource BorderBrush}"
                         BorderThickness="1"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         FontSize="{StaticResource FontSizeBody}"
                         AutomationProperties.Name="{loc:Translate Shell.TabSnippets}" />

                <TextBlock Text="{loc:Translate Manager.Empty}">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource PaletteEmptyTextStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSnippets}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="{loc:Translate Palette.NoMatches}">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource PaletteEmptyTextStyle}">
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasSnippets}" Value="True" />
                                        <Condition Binding="{Binding IsEmpty}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DockPanel>

        <DockPanel Grid.Column="1">

            <TextBlock DockPanel.Dock="Top"
                       Text="{loc:Translate Palette.Parameters}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="{StaticResource FontSizeCaption}"
                       Margin="{StaticResource MarginLabelBottom}" />

            <ScrollViewer DockPanel.Dock="Top"
                          MaxHeight="150"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Fields}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="{StaticResource MarginStackItem}">
                                <TextBlock DockPanel.Dock="Left"
                                           Text="{Binding Label}"
                                           Width="130"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="{StaticResource FontSizeBody}" />
                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{StaticResource SurfaceBrush}"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         CaretBrush="{StaticResource TextPrimaryBrush}"
                                         BorderBrush="{StaticResource BorderBrush}"
                                         Padding="{StaticResource PaddingInput}"
                                         AutomationProperties.Name="{Binding Label}" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="{loc:Translate Palette.Inject}"
                        Command="{Binding InjectCommand}"
                        IsEnabled="{Binding CanInject}"
                        IsDefault="True"
                        Padding="{StaticResource PaddingButtonPrimary}"
                        Background="{StaticResource AccentBrush}"
                        Foreground="{StaticResource ActionOnBrightBrush}"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        AutomationProperties.Name="{loc:Translate Palette.Inject}" />
            </StackPanel>

            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Margin="0,16,0,0"
                    Padding="{StaticResource PaddingSectionCard}">
                <TextBox Text="{Binding Preview, Mode=OneWay}"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Background="Transparent"
                         Foreground="{StaticResource SuccessBrush}"
                         BorderThickness="0"
                         FontFamily="Consolas"
                         FontSize="{StaticResource FontSizeBody}"
                         AutomationProperties.Name="{loc:Translate History.Preview}" />
            </Border>
        </DockPanel>
    </Grid>
</Window>
