<UserControl x:Class="Scrybe.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Scrybe.App.Localization"
             Background="{StaticResource BackgroundBrush}"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <Style x:Key="HistoryCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="{StaticResource PaddingSectionCard}" />
        </Style>
        <Style x:Key="HistoryHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSubheading}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="HistoryMutedTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="{StaticResource SpacingLg}" MinHeight="520">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource HistoryCardStyle}" Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{loc:Translate History.PaletteTitle}" Style="{StaticResource HistoryHeaderStyle}" />

                    <TextBlock Grid.Row="1"
                               Text="{loc:Translate History.Empty}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource HistoryMutedTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Entries}"
                             SelectedItem="{Binding SelectedEntry}"
                             Background="{StaticResource BackgroundBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderBrush}"
                             BorderThickness="1"
                             FontSize="{StaticResource FontSizeBody}">
                        <ListBox.Style>
                            <Style TargetType="{x:Type ListBox}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,4">
                                    <TextBlock Text="{Binding Preview}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding Timestamp}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="{StaticResource FontSizeCaption}" />
                                        <TextBlock Text=" · "
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="{StaticResource FontSizeCaption}" />
                                        <TextBlock Text="{Binding CharCount}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="{StaticResource FontSizeCaption}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Grid.Row="2"
                            Content="{loc:Translate History.ClearAll}"
                            Command="{Binding ClearAllCommand}"
                            IsEnabled="{Binding HasEntries}"
                            Margin="0,12,0,0"
                            Padding="{StaticResource PaddingButtonPrimary}"
                            Background="{StaticResource ErrorBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            BorderThickness="0" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource HistoryCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{loc:Translate History.Preview}" Style="{StaticResource HistoryHeaderStyle}" />

                    <TextBox Grid.Row="1"
                             Text="{Binding SelectedPreview}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Background="{StaticResource BackgroundBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             CaretBrush="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderBrush}"
                             Padding="{StaticResource PaddingInput}"
                             FontFamily="Consolas" />

                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,180,0">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{loc:Translate History.Delete}"
                                    Command="{Binding DeleteCommand}"
                                    IsEnabled="{Binding CanCopy}"
                                    Margin="0,0,8,0"
                                    Padding="{StaticResource PaddingButtonPrimary}"
                                    Background="{StaticResource ErrorBrush}"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    BorderThickness="0" />
                            <Button Content="{loc:Translate History.Copy}"
                                    Command="{Binding CopyCommand}"
                                    IsEnabled="{Binding CanCopy}"
                                    Padding="{StaticResource PaddingButtonPrimary}"
                                    Background="{StaticResource AccentBrush}"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    BorderThickness="0"
                                    FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
