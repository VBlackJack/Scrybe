<UserControl x:Class="Scrybe.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Scrybe.App.Localization"
             Background="{StaticResource BackgroundBrush}"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <Style x:Key="HistoryCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="{StaticResource PaddingSectionCard}" />
        </Style>
        <Style x:Key="HistoryHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSubheading}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="HistoryMutedTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="{StaticResource SpacingLg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource HistoryCardStyle}" Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{loc:Translate History.PaletteTitle}" Style="{StaticResource HistoryHeaderStyle}" />

                    <TextBlock Grid.Row="1"
                               Text="{loc:Translate History.Empty}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource HistoryMutedTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Entries}"
                             SelectedItem="{Binding SelectedEntry}"
                             AutomationProperties.Name="{loc:Translate History.PaletteTitle}"
                             Background="{StaticResource BackgroundBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderBrush}"
                             BorderThickness="1"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                             FontSize="{StaticResource FontSizeBody}">
                        <ListBox.Style>
                            <Style TargetType="{x:Type ListBox}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,4">
                                    <TextBlock Text="{Binding Preview}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding Timestamp}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="{StaticResource FontSizeCaption}" />
                                        <TextBlock Text=" · "
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="{StaticResource FontSizeCaption}" />
                                        <TextBlock Text="{Binding CharCount}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="{StaticResource FontSizeCaption}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Grid.Row="2"
                            Command="{Binding ClearAllCommand}"
                            IsEnabled="{Binding HasEntries}"
                            Margin="0,12,0,0"
                            Padding="{StaticResource PaddingButtonPrimary}"
                            Background="{StaticResource ErrorBrush}"
                            Foreground="{StaticResource ActionOnBrightBrush}"
                            BorderThickness="0"
                            AutomationProperties.Name="{loc:Translate History.ClearAll}">
                        <StackPanel Style="{StaticResource AppIconTextContentStyle}">
                            <TextBlock Text="{StaticResource IconActionClear}" Style="{StaticResource AppIconGlyphStyle}" />
                            <TextBlock Text="{loc:Translate History.ClearAll}" Style="{StaticResource AppIconTextStyle}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource HistoryCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{loc:Translate History.Edit}" Style="{StaticResource HistoryHeaderStyle}" />

                    <TextBlock Grid.Row="1"
                               Text="{loc:Translate History.RevealHint}"
                               Style="{StaticResource HistoryMutedTextStyle}"
                               Margin="0,0,0,8" />

                    <TextBox Grid.Row="2"
                             Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsTextRevealed}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Background="{StaticResource BackgroundBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             CaretBrush="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderBrush}"
                             Padding="{StaticResource PaddingInput}"
                             FontFamily="Consolas"
                             AutomationProperties.Name="{loc:Translate History.Edit}" />

                    <TextBlock Grid.Row="3"
                               Text="{Binding StatusMessage}"
                               VerticalAlignment="Bottom"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Grid Grid.Row="4" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Button Command="{Binding DeleteCommand}"
                                IsEnabled="{Binding CanCopy}"
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,0,4,8"
                                HorizontalAlignment="Stretch"
                                Padding="{StaticResource PaddingButtonPrimary}"
                                Background="{StaticResource ErrorBrush}"
                                Foreground="{StaticResource ActionOnBrightBrush}"
                                BorderThickness="0"
                                AutomationProperties.Name="{loc:Translate History.Delete}">
                            <StackPanel Style="{StaticResource AppIconTextContentStyle}">
                                <TextBlock Text="{StaticResource IconActionDelete}" Style="{StaticResource AppIconGlyphStyle}" />
                                <TextBlock Text="{loc:Translate History.Delete}" Style="{StaticResource AppIconTextStyle}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding RevealCommand}"
                                IsEnabled="{Binding CanReveal}"
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="4,0,0,8"
                                HorizontalAlignment="Stretch"
                                Padding="{StaticResource PaddingButtonPrimary}"
                                Background="{StaticResource CardBrush}"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                AutomationProperties.Name="{loc:Translate History.Reveal}">
                            <StackPanel Style="{StaticResource AppIconTextContentStyle}">
                                <TextBlock Text="{StaticResource IconActionReveal}" Style="{StaticResource AppIconGlyphStyle}" />
                                <TextBlock Text="{loc:Translate History.Reveal}" Style="{StaticResource AppIconTextStyle}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SaveEditCommand}"
                                IsEnabled="{Binding CanSaveEdit}"
                                Grid.Row="1"
                                Grid.Column="0"
                                Margin="0,0,4,0"
                                HorizontalAlignment="Stretch"
                                Padding="{StaticResource PaddingButtonPrimary}"
                                Background="{StaticResource CardBrush}"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                BorderThickness="0"
                                FontWeight="SemiBold"
                                AutomationProperties.Name="{loc:Translate History.SaveChanges}">
                            <StackPanel Style="{StaticResource AppIconTextContentStyle}">
                                <TextBlock Text="{StaticResource IconActionSave}" Style="{StaticResource AppIconGlyphStyle}" />
                                <TextBlock Text="{loc:Translate History.SaveChanges}" Style="{StaticResource AppIconTextStyle}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CopyCommand}"
                                IsEnabled="{Binding CanCopy}"
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="4,0,0,0"
                                HorizontalAlignment="Stretch"
                                Padding="{StaticResource PaddingButtonPrimary}"
                                Background="{StaticResource AccentBrush}"
                                Foreground="{StaticResource ActionOnBrightBrush}"
                                BorderThickness="0"
                                FontWeight="SemiBold"
                                AutomationProperties.Name="{loc:Translate History.Copy}">
                            <StackPanel Style="{StaticResource AppIconTextContentStyle}">
                                <TextBlock Text="{StaticResource IconActionCopy}" Style="{StaticResource AppIconGlyphStyle}" />
                                <TextBlock Text="{loc:Translate History.Copy}" Style="{StaticResource AppIconTextStyle}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
    </Grid>
</UserControl>
