<Window x:Class="Scrybe.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Scrybe.App.Localization"
        xmlns:views="clr-namespace:Scrybe.App.Views"
        Title="{loc:Translate Settings.Title}"
        Height="640"
        Width="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSubheading}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="170" />
        </Style>
        <Style x:Key="SettingCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,6,0,6" />
        </Style>
        <Style x:Key="SettingComboStyle" TargetType="ComboBox" BasedOn="{StaticResource AppComboBoxStyle}">
            <Setter Property="Width" Value="260" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style x:Key="SettingTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Padding" Value="{StaticResource PaddingInput}" />
            <Setter Property="Width" Value="260" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="{StaticResource PaddingSectionCard}" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="ReadOnlyValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="{StaticResource SpacingLg}">

        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" HorizontalAlignment="Left" />
            <Button Content="{loc:Translate Settings.Save}"
                    Command="{Binding SaveCommand}"
                    HorizontalAlignment="Right"
                    Padding="{StaticResource PaddingButtonPrimary}"
                    Background="{StaticResource AccentBrush}"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    BorderThickness="0"
                    FontWeight="SemiBold" />
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{loc:Translate Settings.General}" Style="{StaticResource SectionHeaderStyle}" />
                        <CheckBox Content="{loc:Translate Settings.EnableLogging}" IsChecked="{Binding EnableLogging}" Style="{StaticResource SettingCheckBoxStyle}" />
                        <CheckBox Content="{loc:Translate Settings.PrewarmOnStartup}" IsChecked="{Binding PrewarmOnStartup}" Style="{StaticResource SettingCheckBoxStyle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{loc:Translate Settings.Locale}" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox ItemsSource="{Binding LocaleChoices}" SelectedValuePath="Value" SelectedValue="{Binding LocaleCode}" Style="{StaticResource SettingComboStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{loc:Translate Settings.Ocr}" Style="{StaticResource SectionHeaderStyle}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Translate Settings.CleanupMode}" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox ItemsSource="{Binding CleanupModeChoices}" SelectedValuePath="Value" SelectedValue="{Binding CleanupMode}" Style="{StaticResource SettingComboStyle}" />
                        </StackPanel>
                        <CheckBox Content="{loc:Translate Settings.EnablePreprocessing}" IsChecked="{Binding EnablePreprocessing}" Style="{StaticResource SettingCheckBoxStyle}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{loc:Translate Settings.Injection}" Style="{StaticResource SectionHeaderStyle}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Translate Settings.InjectionMode}" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox ItemsSource="{Binding InjectionModeChoices}" SelectedValuePath="Value" SelectedValue="{Binding InjectionMode}" Style="{StaticResource SettingComboStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="{loc:Translate Settings.Pacing}" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding InjectionKeyDelayMs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingTextBoxStyle}" Width="100" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{loc:Translate Settings.Captures}" Style="{StaticResource SectionHeaderStyle}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Translate Settings.CapturesDirectory}" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding CapturesDirectory, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingTextBoxStyle}" />
                        </StackPanel>
                        <CheckBox Content="{loc:Translate Settings.SaveCaptureCrop}" IsChecked="{Binding SaveCaptureCrop}" Style="{StaticResource SettingCheckBoxStyle}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{loc:Translate Settings.Hotkeys}" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock Text="{loc:Translate Settings.HotkeysNote}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <views:HotkeyRecorder DataContext="{Binding CaptureRecorder}" />
                        <views:HotkeyRecorder DataContext="{Binding InjectRecorder}" />
                        <views:HotkeyRecorder DataContext="{Binding AbortRecorder}" />
                        <views:HotkeyRecorder DataContext="{Binding PaletteRecorder}" />
                        <views:HotkeyRecorder DataContext="{Binding SecretPaletteRecorder}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
