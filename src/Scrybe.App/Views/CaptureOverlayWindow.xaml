<Window x:Class="Scrybe.App.Views.CaptureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="False"
        Background="Black"
        WindowStartupLocation="Manual"
        Cursor="Cross"
        Focusable="True"
        UseLayoutRounding="True">

    <Grid x:Name="RootGrid" ClipToBounds="True">

        <!-- Frozen capture of the selected monitor, shown full-bleed. -->
        <Image x:Name="FrozenImage" Stretch="Fill" />

        <Canvas x:Name="OverlayCanvas">

            <!-- Dim scrim with the current selection cut out. -->
            <Path x:Name="ScrimPath" Fill="{DynamicResource ScrimBrush}" IsHitTestVisible="False" />

            <!-- Selection rectangle border. -->
            <Rectangle x:Name="SelectionRectangle"
                       Stroke="{DynamicResource AccentBrush}"
                       StrokeThickness="2"
                       Visibility="Collapsed"
                       IsHitTestVisible="False" />

            <!-- Magnifier loupe following the cursor. -->
            <Border x:Name="LoupeBorder"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="2"
                    Visibility="Collapsed"
                    IsHitTestVisible="False"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Rectangle x:Name="LoupeSurface" RenderOptions.BitmapScalingMode="NearestNeighbor">
                        <Rectangle.Fill>
                            <ImageBrush x:Name="LoupeBrush"
                                        ViewboxUnits="RelativeToBoundingBox"
                                        Stretch="Fill" />
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle Width="1" HorizontalAlignment="Center"
                               Fill="{DynamicResource InfoBrush}" Opacity="0.5" IsHitTestVisible="False" />
                    <Rectangle Height="1" VerticalAlignment="Center"
                               Fill="{DynamicResource InfoBrush}" Opacity="0.5" IsHitTestVisible="False" />
                    <Rectangle x:Name="LoupeCenterMarker"
                               Stroke="{DynamicResource AccentBrush}" StrokeThickness="1"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsHitTestVisible="False" />
                </Grid>
            </Border>

            <!-- Live physical-pixel dimensions readout. -->
            <Border x:Name="ReadoutBorder"
                    Background="{DynamicResource CardBrush}"
                    Padding="{StaticResource PaddingSectionCard}"
                    CornerRadius="4"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
                <TextBlock x:Name="ReadoutText"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="{StaticResource FontSizeBody}"
                           FontWeight="SemiBold" />
            </Border>

            <!-- Instructions hint, hidden once dragging starts. -->
            <Border x:Name="HintBorder"
                    Background="{DynamicResource SurfaceBrush}"
                    Padding="{StaticResource PaddingSectionCard}"
                    CornerRadius="4"
                    IsHitTestVisible="False">
                <TextBlock x:Name="HintText"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="{StaticResource FontSizeBody}" />
            </Border>

        </Canvas>
    </Grid>
</Window>
