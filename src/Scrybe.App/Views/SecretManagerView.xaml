<UserControl x:Class="Scrybe.App.Views.SecretManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Scrybe.App.Localization"
             Background="{StaticResource BackgroundBrush}"
             UseLayoutRounding="True">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="{StaticResource SpacingLg}" MinHeight="360">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="0,0,16,0">
                <Button DockPanel.Dock="Bottom"
                        Content="{loc:Translate Secrets.New}"
                        Command="{Binding NewCommand}"
                        Margin="0,12,0,0"
                        Padding="{StaticResource PaddingButtonPrimary}"
                        Background="{StaticResource CardBrush}"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        BorderThickness="0" />

                <Grid>
                    <ListBox x:Name="SecretList"
                             ItemsSource="{Binding Secrets}"
                             SelectedItem="{Binding SelectedSecret}"
                             DisplayMemberPath="Name"
                             Background="{StaticResource SurfaceBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderBrush}"
                             BorderThickness="1"
                             FontSize="{StaticResource FontSizeBody}" />
                    <TextBlock Text="{loc:Translate Secrets.Empty}">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ManagerEmptyStateTextStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasItems, ElementName=SecretList}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="{StaticResource ManagerFormRowMargin}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource ManagerFormLabelWidth}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{loc:Translate Secrets.Name}"
                               Style="{StaticResource ManagerFormLabelStyle}" />
                    <TextBox Grid.Column="1"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ManagerTextBoxStyle}" />
                </Grid>

                <Grid Grid.Row="1" Margin="{StaticResource ManagerFormRowMargin}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource ManagerFormLabelWidth}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{loc:Translate Secrets.UserName}"
                               Style="{StaticResource ManagerFormLabelStyle}" />
                    <TextBox Grid.Column="1"
                             Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ManagerTextBoxStyle}" />
                </Grid>

                <Grid Grid.Row="2" Margin="{StaticResource ManagerFormRowMargin}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource ManagerFormLabelWidth}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{loc:Translate Secrets.Password}"
                               Style="{StaticResource ManagerFormLabelStyle}" />
                    <PasswordBox x:Name="SecretPasswordBox"
                                 Grid.Column="1"
                                 PasswordChanged="OnPasswordChanged"
                                 Style="{StaticResource ManagerPasswordBoxStyle}" />
                </Grid>

                <TextBlock Grid.Row="3"
                           Text="{Binding StatusMessage}"
                           VerticalAlignment="Bottom"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="{loc:Translate Secrets.Delete}" Command="{Binding DeleteCommand}" Margin="0,0,8,0" Padding="{StaticResource PaddingButtonPrimary}" Background="{StaticResource ErrorBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" />
                    <Button Content="{loc:Translate Secrets.Save}" Command="{Binding SaveCommand}" Padding="{StaticResource PaddingButtonPrimary}" Background="{StaticResource AccentBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
