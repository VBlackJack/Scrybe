<UserControl x:Class="Scrybe.App.Views.SecretManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Scrybe.App.Localization"
             Background="{StaticResource BackgroundBrush}"
             UseLayoutRounding="True">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="{StaticResource SpacingLg}" MinHeight="360">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="0,0,16,0">
                <Button DockPanel.Dock="Bottom"
                        Content="{loc:Translate Secrets.New}"
                        Command="{Binding NewCommand}"
                        Margin="0,12,0,0"
                        Padding="{StaticResource PaddingButtonPrimary}"
                        Background="{StaticResource CardBrush}"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        BorderThickness="0" />
                <ListBox ItemsSource="{Binding Secrets}"
                         SelectedItem="{Binding SelectedSecret}"
                         DisplayMemberPath="Name"
                         Background="{StaticResource SurfaceBrush}"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         BorderBrush="{StaticResource BorderBrush}"
                         BorderThickness="1"
                         FontSize="{StaticResource FontSizeBody}" />
            </DockPanel>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{loc:Translate Secrets.Name}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeCaption}" Margin="{StaticResource MarginLabelBottom}" />
                <TextBox Grid.Row="0" Margin="120,0,0,10" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}" CaretBrush="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush}" Padding="{StaticResource PaddingInput}" />

                <TextBlock Grid.Row="1" Text="{loc:Translate Secrets.UserName}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeCaption}" Margin="{StaticResource MarginLabelBottom}" />
                <TextBox Grid.Row="1" Margin="120,0,0,10" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}" CaretBrush="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush}" Padding="{StaticResource PaddingInput}" />

                <TextBlock Grid.Row="2" Text="{loc:Translate Secrets.Password}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeCaption}" Margin="{StaticResource MarginLabelBottom}" />
                <PasswordBox x:Name="SecretPasswordBox"
                             Grid.Row="2"
                             Margin="120,0,0,10"
                             PasswordChanged="OnPasswordChanged"
                             Background="{StaticResource SurfaceBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             CaretBrush="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderBrush}"
                             Padding="{StaticResource PaddingInput}" />

                <TextBlock Grid.Row="3"
                           Text="{Binding StatusMessage}"
                           VerticalAlignment="Bottom"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="{loc:Translate Secrets.Delete}" Command="{Binding DeleteCommand}" Margin="0,0,8,0" Padding="{StaticResource PaddingButtonPrimary}" Background="{StaticResource ErrorBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" />
                    <Button Content="{loc:Translate Secrets.Save}" Command="{Binding SaveCommand}" Padding="{StaticResource PaddingButtonPrimary}" Background="{StaticResource AccentBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
