<Window x:Class="Scrybe.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Scrybe.App.Localization"
        xmlns:views="clr-namespace:Scrybe.App.Views"
        Title="{Binding Title}"
        Height="720"
        Width="760"
        MinHeight="640"
        MinWidth="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="HubSectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSubtitle}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="HubCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="{StaticResource PaddingSectionCard}" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="HubActionButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
            <Setter Property="Padding" Value="{StaticResource PaddingButtonPrimary}" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="HubSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource HubActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="HubVersionButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="HubFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="HubValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style x:Key="HubHotkeyValueStyle" TargetType="TextBlock" BasedOn="{StaticResource HubValueStyle}">
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>
        <Style x:Key="HubComboStyle" TargetType="ComboBox" BasedOn="{StaticResource AppComboBoxStyle}">
            <Setter Property="MinWidth" Value="220" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </Window.Resources>

    <TabControl SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
        <TabItem AutomationProperties.Name="{loc:Translate Shell.TabHome}">
            <TabItem.Header>
                <StackPanel Style="{StaticResource AppIconTextContentStyle}">
                    <TextBlock Text="{StaticResource IconTabHome}" Style="{StaticResource AppIconGlyphStyle}" />
                    <TextBlock Text="{loc:Translate Shell.TabHome}" Style="{StaticResource AppIconTextStyle}" />
                </StackPanel>
            </TabItem.Header>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="{StaticResource SpacingLg}">
                    <StackPanel HorizontalAlignment="Center" Margin="0,4,0,20">

                        <TextBlock Style="{StaticResource AppTitleTextStyle}"
                                   Text="{Binding Title}"
                                   AutomationProperties.Name="{Binding Title}" />

                        <TextBlock Style="{StaticResource AppTaglineTextStyle}"
                                   Text="{Binding Tagline}"
                                   AutomationProperties.Name="{Binding Tagline}"
                                   MaxWidth="440" />

                        <Button Command="{Binding OpenAboutCommand}"
                                Style="{StaticResource HubVersionButtonStyle}"
                                AutomationProperties.Name="{loc:Translate About.Title}">
                            <TextBlock Style="{StaticResource AppVersionTextStyle}"
                                       Text="{Binding VersionText}" />
                        </Button>

                    </StackPanel>

                    <Border Style="{StaticResource HubCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{loc:Translate Hub.ActionsTitle}"
                                       Style="{StaticResource HubSectionHeaderStyle}" />

                            <Button Command="{Binding CaptureCommand}"
                                    Style="{StaticResource HubActionButtonStyle}"
                                    Margin="0,0,0,12"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.Name="{loc:Translate Hub.Capture}">
                                <StackPanel Style="{StaticResource AppIconTextContentStyle}">
                                    <TextBlock Text="{StaticResource IconActionCapture}" Style="{StaticResource AppIconGlyphStyle}" />
                                    <TextBlock Text="{loc:Translate Hub.Capture}" Style="{StaticResource AppIconTextStyle}" />
                                </StackPanel>
                            </Button>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{loc:Translate Hub.CleanupModeLabel}"
                                           Style="{StaticResource HubFieldLabelStyle}"
                                           ToolTip="{loc:Translate ToolTip.Settings.CleanupMode}" />
                                <ComboBox Grid.Column="2"
                                          ItemsSource="{Binding CleanupModeChoices}"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding SelectedCleanupMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource HubComboStyle}"
                                          ToolTip="{loc:Translate ToolTip.Settings.CleanupMode}"
                                          AutomationProperties.Name="{loc:Translate Hub.CleanupModeLabel}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource HubCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{loc:Translate Hub.StatusTitle}"
                                       Style="{StaticResource HubSectionHeaderStyle}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Translate Hub.InjectionMode}" Style="{StaticResource HubFieldLabelStyle}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding InjectionModeText}" Style="{StaticResource HubValueStyle}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Translate Hub.SnippetCount}" Style="{StaticResource HubFieldLabelStyle}" Margin="0,6,0,0" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SnippetCount}" Style="{StaticResource HubValueStyle}" Margin="16,6,0,0" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Translate Hub.SecretCount}" Style="{StaticResource HubFieldLabelStyle}" Margin="0,6,0,0" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SecretCount}" Style="{StaticResource HubValueStyle}" Margin="16,6,0,0" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Translate Hub.HistoryCount}" Style="{StaticResource HubFieldLabelStyle}" Margin="0,6,0,0" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding HistoryCount}" Style="{StaticResource HubValueStyle}" Margin="16,6,0,0" />
                            </Grid>

                            <TextBlock Text="{loc:Translate Hub.HotkeysTitle}"
                                       Style="{StaticResource HubSectionHeaderStyle}"
                                       Margin="0,16,0,8" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Translate Hub.CaptureHotkey}" Style="{StaticResource HubFieldLabelStyle}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CaptureHotkeyText}" Style="{StaticResource HubHotkeyValueStyle}" Margin="16,0,0,0" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Translate Hub.InjectHotkey}" Style="{StaticResource HubFieldLabelStyle}" Margin="0,6,0,0" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding InjectHotkeyText}" Style="{StaticResource HubHotkeyValueStyle}" Margin="16,6,0,0" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Translate Hub.ClipboardInjectHotkey}" Style="{StaticResource HubFieldLabelStyle}" Margin="0,6,0,0" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ClipboardInjectHotkeyText}" Style="{StaticResource HubHotkeyValueStyle}" Margin="16,6,0,0" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Translate Hub.AbortHotkey}" Style="{StaticResource HubFieldLabelStyle}" Margin="0,6,0,0" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AbortHotkeyText}" Style="{StaticResource HubHotkeyValueStyle}" Margin="16,6,0,0" />
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Translate Hub.SnippetPaletteHotkey}" Style="{StaticResource HubFieldLabelStyle}" Margin="0,6,0,0" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SnippetPaletteHotkeyText}" Style="{StaticResource HubHotkeyValueStyle}" Margin="16,6,0,0" />
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="{loc:Translate Hub.SecretPaletteHotkey}" Style="{StaticResource HubFieldLabelStyle}" Margin="0,6,0,0" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SecretPaletteHotkeyText}" Style="{StaticResource HubHotkeyValueStyle}" Margin="16,6,0,0" />
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="{loc:Translate Hub.HistoryPaletteHotkey}" Style="{StaticResource HubFieldLabelStyle}" Margin="0,6,0,0" />
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding HistoryPaletteHotkeyText}" Style="{StaticResource HubHotkeyValueStyle}" Margin="16,6,0,0" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem AutomationProperties.Name="{loc:Translate Shell.TabSnippets}">
            <TabItem.Header>
                <StackPanel Style="{StaticResource AppIconTextContentStyle}">
                    <TextBlock Text="{StaticResource IconTabSnippets}" Style="{StaticResource AppIconGlyphStyle}" />
                    <TextBlock Text="{loc:Translate Shell.TabSnippets}" Style="{StaticResource AppIconTextStyle}" />
                </StackPanel>
            </TabItem.Header>
            <views:SnippetManagerView DataContext="{Binding SnippetManager}" />
        </TabItem>

        <TabItem AutomationProperties.Name="{loc:Translate Shell.TabSecrets}">
            <TabItem.Header>
                <StackPanel Style="{StaticResource AppIconTextContentStyle}">
                    <TextBlock Text="{StaticResource IconTabSecrets}" Style="{StaticResource AppIconGlyphStyle}" />
                    <TextBlock Text="{loc:Translate Shell.TabSecrets}" Style="{StaticResource AppIconTextStyle}" />
                </StackPanel>
            </TabItem.Header>
            <views:SecretManagerView DataContext="{Binding SecretManager}" />
        </TabItem>

        <TabItem AutomationProperties.Name="{loc:Translate Shell.TabHistory}">
            <TabItem.Header>
                <StackPanel Style="{StaticResource AppIconTextContentStyle}">
                    <TextBlock Text="{StaticResource IconTabHistory}" Style="{StaticResource AppIconGlyphStyle}" />
                    <TextBlock Text="{loc:Translate Shell.TabHistory}" Style="{StaticResource AppIconTextStyle}" />
                </StackPanel>
            </TabItem.Header>
            <views:HistoryView DataContext="{Binding HistoryManager}" />
        </TabItem>

        <TabItem AutomationProperties.Name="{loc:Translate Shell.TabSettings}">
            <TabItem.Header>
                <StackPanel Style="{StaticResource AppIconTextContentStyle}">
                    <TextBlock Text="{StaticResource IconTabSettings}" Style="{StaticResource AppIconGlyphStyle}" />
                    <TextBlock Text="{loc:Translate Shell.TabSettings}" Style="{StaticResource AppIconTextStyle}" />
                </StackPanel>
            </TabItem.Header>
            <views:SettingsView DataContext="{Binding Settings}" />
        </TabItem>

        <TabItem AutomationProperties.Name="{loc:Translate Shell.TabAbout}">
            <TabItem.Header>
                <StackPanel Style="{StaticResource AppIconTextContentStyle}">
                    <TextBlock Text="{StaticResource IconTabAbout}" Style="{StaticResource AppIconGlyphStyle}" />
                    <TextBlock Text="{loc:Translate Shell.TabAbout}" Style="{StaticResource AppIconTextStyle}" />
                </StackPanel>
            </TabItem.Header>
            <views:AboutView DataContext="{Binding About}" />
        </TabItem>
    </TabControl>

</Window>
