<Window x:Class="Scrybe.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Scrybe.App.Localization"
        Title="{Binding Title}"
        Height="680"
        Width="680"
        MinHeight="620"
        MinWidth="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="HubSectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSubtitle}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="HubCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="{StaticResource PaddingSectionCard}" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="HubActionButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
            <Setter Property="Padding" Value="{StaticResource PaddingButtonPrimary}" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="HubSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource HubActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="HubVersionButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="HubFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="HubValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style x:Key="HubHotkeyValueStyle" TargetType="TextBlock" BasedOn="{StaticResource HubValueStyle}">
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>
        <Style x:Key="HubComboStyle" TargetType="ComboBox" BasedOn="{StaticResource AppComboBoxStyle}">
            <Setter Property="MinWidth" Value="220" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{StaticResource SpacingLg}">
            <StackPanel HorizontalAlignment="Center" Margin="0,4,0,20">

                <TextBlock Style="{StaticResource AppTitleTextStyle}"
                           Text="{Binding Title}"
                           AutomationProperties.Name="{Binding Title}" />

                <TextBlock Style="{StaticResource AppTaglineTextStyle}"
                           Text="{Binding Tagline}"
                           AutomationProperties.Name="{Binding Tagline}"
                           MaxWidth="440" />

                <Button Command="{Binding OpenAboutCommand}"
                        Style="{StaticResource HubVersionButtonStyle}"
                        AutomationProperties.Name="{loc:Translate About.Title}">
                    <TextBlock Style="{StaticResource AppVersionTextStyle}"
                               Text="{Binding VersionText}" />
                </Button>

            </StackPanel>

            <Border Style="{StaticResource HubCardStyle}">
                <StackPanel>
                    <TextBlock Text="{loc:Translate Hub.ActionsTitle}"
                               Style="{StaticResource HubSectionHeaderStyle}" />

                    <UniformGrid Columns="3" Margin="0,0,0,12">
                        <Button Content="{loc:Translate Hub.Capture}"
                                Command="{Binding CaptureCommand}"
                                Style="{StaticResource HubActionButtonStyle}"
                                AutomationProperties.Name="{loc:Translate Hub.Capture}" />
                        <Button Content="{loc:Translate Hub.CaptureHistory}"
                                Command="{Binding OpenHistoryCommand}"
                                Style="{StaticResource HubSecondaryButtonStyle}"
                                AutomationProperties.Name="{loc:Translate Hub.CaptureHistory}" />
                        <Button Content="{loc:Translate Hub.Settings}"
                                Command="{Binding OpenSettingsCommand}"
                                Style="{StaticResource HubSecondaryButtonStyle}"
                                AutomationProperties.Name="{loc:Translate Hub.Settings}" />
                        <Button Content="{loc:Translate Hub.ManageSnippets}"
                                Command="{Binding ManageSnippetsCommand}"
                                Style="{StaticResource HubSecondaryButtonStyle}"
                                AutomationProperties.Name="{loc:Translate Hub.ManageSnippets}" />
                        <Button Content="{loc:Translate Hub.ManageSecrets}"
                                Command="{Binding ManageSecretsCommand}"
                                Style="{StaticResource HubSecondaryButtonStyle}"
                                AutomationProperties.Name="{loc:Translate Hub.ManageSecrets}" />
                    </UniformGrid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{loc:Translate Hub.CleanupModeLabel}"
                                   Style="{StaticResource HubFieldLabelStyle}" />
                        <ComboBox Grid.Column="2"
                                  ItemsSource="{Binding CleanupModeChoices}"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding SelectedCleanupMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource HubComboStyle}"
                                  AutomationProperties.Name="{loc:Translate Hub.CleanupModeLabel}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource HubCardStyle}">
                <StackPanel>
                    <TextBlock Text="{loc:Translate Hub.StatusTitle}"
                               Style="{StaticResource HubSectionHeaderStyle}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Translate Hub.InjectionMode}" Style="{StaticResource HubFieldLabelStyle}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding InjectionModeText}" Style="{StaticResource HubValueStyle}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Translate Hub.CleanupMode}" Style="{StaticResource HubFieldLabelStyle}" Margin="0,6,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CleanupModeText}" Style="{StaticResource HubValueStyle}" Margin="16,6,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Translate Hub.SnippetCount}" Style="{StaticResource HubFieldLabelStyle}" Margin="0,6,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SnippetCount}" Style="{StaticResource HubValueStyle}" Margin="16,6,0,0" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Translate Hub.SecretCount}" Style="{StaticResource HubFieldLabelStyle}" Margin="0,6,0,0" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SecretCount}" Style="{StaticResource HubValueStyle}" Margin="16,6,0,0" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Translate Hub.HistoryCount}" Style="{StaticResource HubFieldLabelStyle}" Margin="0,6,0,0" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding HistoryCount}" Style="{StaticResource HubValueStyle}" Margin="16,6,0,0" />
                    </Grid>

                    <TextBlock Text="{loc:Translate Hub.HotkeysTitle}"
                               Style="{StaticResource HubSectionHeaderStyle}"
                               Margin="0,16,0,8" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Translate Hub.CaptureHotkey}" Style="{StaticResource HubFieldLabelStyle}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CaptureHotkeyText}" Style="{StaticResource HubHotkeyValueStyle}" Margin="16,0,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Translate Hub.InjectHotkey}" Style="{StaticResource HubFieldLabelStyle}" Margin="0,6,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding InjectHotkeyText}" Style="{StaticResource HubHotkeyValueStyle}" Margin="16,6,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Translate Hub.AbortHotkey}" Style="{StaticResource HubFieldLabelStyle}" Margin="0,6,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AbortHotkeyText}" Style="{StaticResource HubHotkeyValueStyle}" Margin="16,6,0,0" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Translate Hub.SnippetPaletteHotkey}" Style="{StaticResource HubFieldLabelStyle}" Margin="0,6,0,0" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SnippetPaletteHotkeyText}" Style="{StaticResource HubHotkeyValueStyle}" Margin="16,6,0,0" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Translate Hub.SecretPaletteHotkey}" Style="{StaticResource HubFieldLabelStyle}" Margin="0,6,0,0" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SecretPaletteHotkeyText}" Style="{StaticResource HubHotkeyValueStyle}" Margin="16,6,0,0" />
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="{loc:Translate Hub.HistoryPaletteHotkey}" Style="{StaticResource HubFieldLabelStyle}" Margin="0,6,0,0" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding HistoryPaletteHotkeyText}" Style="{StaticResource HubHotkeyValueStyle}" Margin="16,6,0,0" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>

</Window>
