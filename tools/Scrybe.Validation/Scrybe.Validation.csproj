<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <StartupObject>Scrybe.Validation.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.IO" />
    <ProjectReference Include="../../src/Scrybe.App/Scrybe.App.csproj" />
    <None Include="corpus.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../locales/*.json" Link="locales/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../tessdata/*.traineddata" Link="tessdata/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
